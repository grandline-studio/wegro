# ==============================================================================
# WeGro Finance — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Admin Authentication Credentials
# ------------------------------------------------------------------------------
# WARNING: The default credentials (admin / wegro@123) are strictly for local
# development. In production, provide strong secrets and change the admin password.
ADMIN_ID=admin
ADMIN_PASSWORD=wegro@123
ADMIN_JWT_SECRET=wegro_production_jwt_secret_key_minimum_32_characters_long_for_security

# ------------------------------------------------------------------------------
# 2. Storage Adapter Configuration
# ------------------------------------------------------------------------------
# Options: 'json' (default for local development) or 'supabase' (for production)
# Note: Vercel serverless filesystems are ephemeral. ALWAYS use 'supabase' in production!
STORAGE_ADAPTER=json

# ------------------------------------------------------------------------------
# 3. Supabase Database Configuration (Required when STORAGE_ADAPTER=supabase)
# ------------------------------------------------------------------------------
# Found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 4. Public Site URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:5173
